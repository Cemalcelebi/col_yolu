 "aday_anahtar_sha": "a859f79924ae145eeb32597ca6734c54ae844185b1fd8e75caec6747b0961744",
 "kapak": "Bu sette 24 bölge var. İstediğin gibi her sayfada artık iki grafik var: üstte bölgenin gerisi (önceki 120 mum) ve bölge, altta yakından bölge. Sonrası yok. Hepsi mum boyu şartını geçen adaylar (oran en çok 0,70); hakem seçmedi, karışık. Her sayfada bir kutuyu işaretle; en iyilere yıldız koyabilirsin. Önceki sette (gerisi görünmeden) 23 bölgenin 7'sine benziyor dedin.",
 "secilen_zaman": {
  "gunluk": 20,
  "haftalik": 4
 },
 "ozet": {
  "uzak_onceki_bar": {
   "en_kucuk": 57,
   "medyan": 120.0,
   "en_buyuk": 120
  },
  "oran": {
   "en_kucuk": 0.2469554509076075,
   "medyan": 0.6518687003443785,
   "en_buyuk": 0.6996124493100297
  }
 },
 "olcu": {
  "boy": "BOY_MUTLAK = bölge barlarında (H - L) / C medyanı (%); ÖNCEKİ = bölge başından önceki en çok 120 barın (H - L) / C medyanı (en az 40 bar, yoksa boş); ORAN = BOY_MUTLAK / ÖNCEKİ (İŞ A BOY_MUTLAK / BOY_OZ tanımı); yalnız bölge sonu t'ye kadarki barlar (t + 1 ve sonrası kullanılmaz: assert)",
  "sinir": "dikey sınır = pencere barlarının O / H / L / C değerlerinin %2 - %98 dilimi ile bölge barlarının en düşük L / en yüksek H'sinin birleşimi; bölgedeki Bollinger üst / alt bandı görünsün diye her yönde en çok bu açıklığın %15'i kadar genişler (mum ölçeği ezilmesin); ± %4 pay; bunu aşan fitil / bant çerçevede kesilir, kesilen yere kenarda küçük üçgen (mum: her kesilen mumda koyu kırmızı; bant: her kesik parçada bir mor)",
  "eksen": "sağda yüzde ekseni: 0 = bölgenin son kapanışı; adım listeden 4-8 çizgi verecek en küçük adım; ince yatay kılavuz; fiyat / tarih / hisse yok"
 },
 "sayfa_duzeni": "kapak + geçmişli sayfa: ÜST uzak görünüm = bölgeden önceki en çok 120 mum (mumun kendi zaman diliminde; daha az varsa olan kadar, en az 40, yoksa DUR) + bölge; ALT yakın görünüm = EK 16 ölçekli sayfanın grafiği (öncesi 15 mum + bölge); ikisinde de sağda yüzde ekseni (0 = bölgenin son kapanışı), Bollinger 20 + SMA20, bölge turuncu kutu (iki grafikte aynı barlar), uç fitil kesimi + işaret (HK-OL kuralı, her grafik kendi penceresiyle); altında mum boyu satırı ve ✓ / K / × kutuları; 'Senin kalıbın' küçük; katman / hakem kararı / hisse / tarih / fiyat / SONRASI YOK",
